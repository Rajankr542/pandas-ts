{
  "name": "pandas-ts",
  "version": "1.1.0",
  "description": "pandas for TypeScript and JavaScript — ~99% pandas API parity, powered by @cyfora/numera's C++ core.",
  "keywords": [
    "pandas",
    "pandas-ts",
    "dataframe",
    "series",
    "data-analysis",
    "data-science",
    "data-manipulation",
    "typescript",
    "javascript",
    "nodejs",
    "csv",
    "groupby",
    "time-series",
    "analytics",
    "numera",
    "numpy"
  ],
  "author": "Rajan Kumar <rajankr542@gmail.com>",
  "license": "MIT",
  "homepage": "https://pandas-ts.cyfora.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajankr542/pandas-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Rajankr542/pandas-ts/issues"
  },
  "type": "module",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry": "node scripts/release.mjs --dry-run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@cyfora/numera": "^1.0.3",
    "xlsx": "^0.18.5"
  }
}
